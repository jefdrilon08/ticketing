%li{ class: "#{['system_tickets', 'concern_tickets'].include?(params[:controller]) ? 'active' : ''}" }
  .icon-link
    = link_to "#tickets-submenu", role: "button", data: { sidebar_toggle: true }, "aria-expanded" => "false", "aria-controls" => "tickets-submenu" do
      %i.bi.bi-ticket-detailed-fill
      %span.link-name
        Tickets
    %i.bi.bi-caret-down.arrow
  %ul.sub-menu#tickets-submenu
    %li
      = link_to "#", class: "link-name" do
        Tickets
    %li
      = link_to "/system_tickets" do
        %i.bi.bi-ticket
        User Story
    %li
      = link_to concern_tickets_path, class: "" do
        %i.bi.bi-receipt
        Concern Tickets
