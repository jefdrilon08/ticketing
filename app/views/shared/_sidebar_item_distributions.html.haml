%li{ class: "#{['item_distributions'].include?(params[:controller]) ? 'active' : ''}" }
  .icon-link
    = link_to "#item-distributions-submenu", role: "button", data: { sidebar_toggle: true }, "aria-expanded" => "false", "aria-controls" => "item-distributions-submenu" do
      %i.bi.bi-box
      %span.link-name
        Item Distribution
    %i.bi.bi-caret-down.arrow
  %ul.sub-menu#item-distributions-submenu
    %li
      = link_to "#", class: "link-name" do
        Item Distribution
    %li
      = link_to item_distributions_path do
        %i.bi.bi-box-seam
        View Distributions