.row
  .col-md-3{:style=>"padding:20px"}
    %div
      = link_to "/concern_tickets", class: "btn-nav-square-md w-100", style: "padding:100px 10px" do
        %center
          %h4
            TOTAL CONCERN TICKETS
          %hr{:style=>"color:white"}
          %h1
            #{ConcernTicketDetail.count}

  .col{:style=>"padding:20px"}
    %div
      .card{:style=>"background-color:#0D6EFD;border-color:transparent;padding:30px 20px;width:100%"}
        %h5{:style=>"color:white"}
          Open
        %hr{:style=>"color:white"}
        %center
          %h1{:style=>"color:white"}
            #{@open_tickets.count}

  .col{:style=>"padding:20px"}
    %div
      .card{:style=>"background-color:#0D6EFD;border-color:transparent;padding:30px 20px"}
        %h5{:style=>"color:white"}
          Proccessing
        %hr{:style=>"color:white"}
        %center
          %h1{:style=>"color:white"}
            #{@progress_tickets.count}

  .col{:style=>"padding:20px"}
    %div
      .card{:style=>"background-color:#0D6EFD;border-color:transparent;padding:30px 20px"}
        %h5{:style=>"color:white"}
          Verification
        %hr{:style=>"color:white"}
        %center
          %h1{:style=>"color:white"}
            #{@forverification_tickets.count}

  .col{:style=>"padding:20px"}
    %div
      .card{:style=>"background-color:#0D6EFD;border-color:transparent;padding:30px 20px"}
        %h5{:style=>"color:white"}
          Closed
        %hr{:style=>"color:white"}
        %center
          %h1{:style=>"color:white"}
            #{@closed_tickets.count}
-# %hr{:style=>"height:10px;color:white"}

.d-flex.flex-wrap.align-items-end.gap-3.mb-3
  %div
    %label.form-label{:for => "concern-ticket-select"} Select Concern Ticket
    %select#concern-ticket-select.form-select
      - @concern_tickets.each do |concern_ticket|
        %option{:value => concern_ticket['id']}= concern_ticket['name']
  %div
    %label.form-label{:for => "chart-start-date"} From
    = date_field_tag :chart_start_date, nil, id: "chart-start-date", class: "form-control"
  %div
    %label.form-label{:for => "chart-end-date"} To
    = date_field_tag :chart_end_date, nil, id: "chart-end-date", class: "form-control"

.card{:style=>"padding:20px 20px;height:100%"}
  %div#concern-ticket-charts
    .row
      .col-md-6{:style=>"padding:20px"}
        %h6.text-muted.mb-2 Tickets by Concern Type
        .d-flex.flex-row
          .pie-chart-container{:style => "height:300px; width:100%; position:relative;"}
            %canvas#dynamic-pie-chart{:width=>"400", :height=>"300", :style=>"max-width:100%; max-height:100%;"}
      .col-md-6{:style=>"padding:20px"}
        %h6.text-muted.mb-2 Tickets by Concern From
        .d-flex.flex-row
          .bar-chart-container{:style => "height:300px; width:100%; position:relative;"}
            %canvas#concern-from-bar-chart{:width=>"400", :height=>"300", :style=>"max-width:100%; max-height:100%;"}
      .col-md-6{:style=>"padding:20px"}
        %h6.text-muted.mb-2 Ticket Status by Assigned IT
        .d-flex.flex-row
          .bar-chart-container{:style => "height:300px; width:100%; position:relative;"}
            %canvas#dynamic-bar-chart{:width=>"400", :height=>"300", :style=>"max-width:100%; max-height:100%;"}
      .col-md-6{:style=>"padding:20px"}
        .d-flex.justify-content-between.align-items-start.gap-2.mb-2
          %h6.text-muted.mb-0 Total Tickets by Date
          %div
            %label.form-label.small.mb-1{:for => "ticket-total-period"} Group
            %select#ticket-total-period.form-select.form-select-sm{:style => "width:120px;", :data => { today: Time.zone.today.iso8601 }}
              %option{:value => "yearly"} Yearly
              %option{:value => "monthly"} Monthly
              %option{:value => "weekly"} Weekly
              %option{:value => "hourly"} Hourly
        .d-flex.flex-row
          .line-chart-container{:style => "height:300px; width:100%; position:relative;"}
            %canvas#ticket-total-line-chart{:width=>"400", :height=>"300", :style=>"max-width:100%; max-height:100%;"}
    %br
    -# %br 

= render partial: "templates/error_list"
= render partial: "templates/success_message"