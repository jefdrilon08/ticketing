= title
.container-fluid.px-3
  .row.mb-4
    .col-12
      %h3.mb-0{ style: 'font-weight: bold' } CONCERN TICKET REPORTS
  .breadcrumbs.mb-3
    %nav{:aria => {:label => 'breadcrumb'}}
      %ol.breadcrumb.mb-0
        %li.breadcrumb-item
          = link_to 'Home', root_path
        %li.breadcrumb-item.active{:aria => {'current' => 'page'}}
          Concern Ticket Reports
  .row.mb-3
    .col-12
      = link_to reports_concern_tickets_path, class: 'btn btn-outline-dark btn-lg w-100 text-start', title: 'Summary Report', data: { bs_toggle: 'tooltip' } do
        %div.fw-bold Summary Report
        %small.d-block.mt-1 View summarized concern ticket details and status overview.
  .row
    .col-12
      = link_to view_description_concern_tickets_path, class: 'btn btn-outline-dark btn-lg w-100 text-start', title: 'Ticket Description', data: { bs_toggle: 'tooltip' } do
        %div.fw-bold Ticket Description
        %small.d-block.mt-1 View detailed ticket descriptions and related report information.
        -# = link_to 'Inventory', view_description_concern_tickets_path, class: 'btn btn-primary btn-lg flex-fill', title: 'Inventory', data: { bs_toggle: 'tooltip' }
        -# = link_to 'Item Distribution', view_description_concern_tickets_path, class: 'btn btn-primary btn-lg flex-fill', title: 'Item Distribution', data: { bs_toggle: 'tooltip' }
