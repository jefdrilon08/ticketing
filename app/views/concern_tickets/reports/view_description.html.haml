// Description report: show each ticket's description grouped by Concern From (name_for_id)
.border.rounded.p-3.mb-4
  .d-flex.justify-content-between.align-items-center
    %h2.mb-0
      Ticket Description Report:
      %span.bg-warning.px-2.rounded= @concern_ticket&.name || "Unknown"

  - if @data_store.present?
    .mt-2.text-muted
      %small
        As of:
        %strong= @data_store.start_date.present? ? @data_store.start_date.to_date : "N/A"
        to
        %strong= @data_store.end_date.present? ? @data_store.end_date.to_date : "N/A"

  -# .d-flex.flex-wrap.gap-2
  -#   %span.badge.bg-primary.fs-6 Total: #{@details.size}
  -#   %span.badge.bg-success.text-light.fs-6 New: #{@details.count { |d| d["status"] == "Open" }}
  -#   %span.badge.bg-danger.fs-6 Done: #{@details.count { |d| d["status"] == "Closed" }}

#reports-results
  - valid_details = Array(@details).select { |d| d.is_a?(Hash) }
  - grouped = valid_details.group_by { |d| d["name_for_id"].to_s }

  - if grouped.present?
    .mb-3
      %small.fw-bold.text-uppercase.text-muted Jump to:
      .d-flex.flex-wrap.gap-2.mt-2
        - grouped.sort_by { |name_for_id, _| @concern_fors[name_for_id]&.name.to_s.downcase }.each do |name_for_id, items|
          - concern_from_name = @concern_fors[name_for_id]&.name || "Unspecified"
          %a.btn.btn-sm.btn-outline-dark{:href => "##{name_for_id}"}
            = concern_from_name
            %span.ms-1.text-muted (#{items.size})

    - grouped.sort_by { |name_for_id, _| @concern_fors[name_for_id]&.name.to_s.downcase }.each do |name_for_id, items|
      - concern_from_name = @concern_fors[name_for_id]&.name || "Unspecified"
      .bg-dark.text-white.px-3.py-2.mt-4.mb-2.rounded.d-flex.align-items-center.gap-2{id: name_for_id}
        %h4.mb-0= concern_from_name
        %span.text-white-50.fs-6 (#{items.size})

      .card.mb-3
        .card-body.p-0
          .table-responsive
            %table.table.table-bordered.table-striped.mb-0
              %thead.table-light
                %tr
                  %th Ticket Number
                  %th Description
                  %th Assigned To
              %tbody
                - items.sort_by { |d| d["ticket_number"].to_s }.each do |d|
                  - assigned = (@users || {})[d["assigned_user_id"]&.to_s]
                  - assigned_name = assigned ? [assigned.first_name, assigned.last_name].compact.join(" ") : "Unassigned"
                  %tr
                    %td= d["ticket_number"]
                    %td= d["description"]
                    %td= assigned_name
  - else
    %p.text-muted No ticket descriptions found for this report.
