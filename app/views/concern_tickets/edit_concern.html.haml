.card.some{ style: "padding:1%" }
  - concern_members = @edit_members || @concern_ticket.concern_ticket_users.includes(:user).to_a
  %h2 Edit Concern Ticket
  - if flash[:error].present?
    .alert.alert-danger{ role: "alert" }= flash[:error]
  = form_for @concern_ticket, url: concern_ticket_path(@concern_ticket), method: :patch, html: { id: "edit-concern-form" } do |f|
    .card.border.p-3.mb-3
      %h5 Concern Details
      .row
        .col-md-3.col-12
          .form-group
            %label Name
            = text_field_tag :name, @concern_ticket.name, id: "input-name", class: "form-control", required: true, placeholder: "Enter Name"
        .col-md-3.col-12
          .form-group
            %label Ticket Name
            = text_field_tag :ticket_name, @concern_ticket.ticket_name, id: "input-ticket-name", class: "form-control", required: true, placeholder: "ex.:ABC", size: 6, maxlength: 6
        .col-md-3.col-12
          .form-group
            %label Computer System
            = select_tag :computer_system_id,
              options_from_collection_for_select(@computer_systems&.sort_by(&:name) || [], :id, :name, @concern_ticket.computer_system_id),
              class: "form-control bg-secondary-subtle text-dark border-0 shadow-sm",
              required: false,
              prompt: "-- SELECT --"
        .col-md-3.col-12
          .form-group
            = label_tag :concern_leader_id, "Concern Leader"
            - leader_options = concern_members.select { |member| member.task == "developer" && member.status == "active" }.sort_by { |member| [member.user.last_name.downcase, member.user.first_name.downcase] }
            = select_tag :concern_leader_id, options_for_select(leader_options.map { |member| ["#{member.user.last_name.titleize}, #{member.user.first_name.titleize}", member.user_id] }, @concern_ticket.user_id), class: "form-control", required: true
      .row
        .col-md-3.col-12
          .form-group
            %label Ticket Auto Close (days)
            = number_field_tag :auto_close_days, @concern_ticket.data && @concern_ticket.data["auto_close_days"], id: "input-auto-close-days", class: "form-control", min: 0, placeholder: "Enter days to auto close"
        .col-md-3.col-12
          .form-group
            .form-check
              = hidden_field_tag :is_private, "0"
              = check_box_tag :is_private, "1", @concern_ticket.is_private, id: "is-private-checkbox", class: "form-check-input"
              %label.form-check-label{for: "is-private-checkbox"} Is Private?
            .form-check.mt-2
              = hidden_field_tag :connect_to_item, "0"
              = check_box_tag :connect_to_item, "1", @concern_ticket.connect_to_item, id: "connect-to-item-checkbox", class: "form-check-input"
              %label.form-check-label{for: "connect-to-item-checkbox"} Connect to Item?

    .card.border.p-3.mb-3
      %h5 Concern From and Concern Types
      .row
        .col-md-6.col-12
          .form-group
            %label Concern From
            .input-group
              = text_field_tag :concern_for, "", id: "concern-for-input", class: "form-control", placeholder: "Enter Concern For"
              = button_tag "Add", type: "button", class: "btn btn-outline-primary", id: "add-concern-for"

        .col-md-6.col-12
          .form-group
            %label Concern Type
            .input-group
              = text_field_tag :concern, "", id: "concern-type-input", class: "form-control", placeholder: "Enter Concern Type"
              = button_tag "Add", type: "button", class: "btn btn-outline-primary", id: "add-concern-type"

      .row
        .col-md-6.col-12
          .form-group
            %label Concern From Records:
            %ul#concern-records-list.list-group.mt-2.w-100.p-0
        = hidden_field_tag :selected_concern_fors, "", id: "selected-concern-fors"

        .col-md-6.col-12
          .form-group
            %label Concern Type Records:
            %ul#concern-type-records-list.list-group.mt-2.w-100.p-0
        = hidden_field_tag :selected_concern_types, "", id: "selected-concern-types"

    .row.mt-3
      .col-12
        .card.border.p-3
          %h5 Assign Areas to IT Personnel
          %p.text-muted Select one or more areas.
          = hidden_field_tag :area_assignments_present, "1"
          - developers = concern_members.sort_by { |member| [member.user.last_name.downcase, member.user.first_name.downcase] }
          - assignments = (@concern_ticket.data || {}).fetch("area_developers", {})
          .row
            - developers.each do |member|
              .col-12.col-md-6.form-group.mb-3.developer-areas-row{ hidden: member.task != "developer" || member.status != "active", data: { member_id: member.id } }
                = label_tag "area_picker_#{member.id}", "#{member.user.last_name.titleize}, #{member.user.first_name.titleize}"
                - selected_areas = params[:area_assignments_present].present? ? Array(params[:developer_areas]&.[](member.id.to_s)) : assignments.select { |_, member_id| member_id == member.id.to_s }.keys
                = select_tag "developer_areas[#{member.id}][]", options_from_collection_for_select(@areas || Area.order(:name), :id, :name, selected_areas), multiple: true, id: "developer_areas_#{member.id}", class: "form-control developer-areas-select", disabled: member.task != "developer" || member.status != "active", data: { member_id: member.id }
          %p#area-assignment-error.text-danger.mt-2{ role: "alert", hidden: true }

    &nbsp;
    .row
      .col-12.text-end
        = f.submit "Save Changes", class: "btn btn-success"
        &nbsp;
        = link_to 'Cancel', concern_tickets_path, class: 'btn btn-secondary'

  .card.border.p-3.mt-3
    %h5 Team Members
    = form_tag "/api/v1/tickets/concern_tickets/add_member_concern_ticket", method: :post do
      = hidden_field_tag :concern_ticket_id, @concern_ticket.id
      .row
        .col-md-6.col-12
          .form-group
            %label Add Team Members:
            - member_user_ids = @concern_ticket.concern_ticket_users.pluck(:user_id).to_set
            .d-flex
              = select_tag :ct_user_id,
                options_for_select(@ct_users.map { |user| ["#{user.last_name.titleize}, #{user.first_name.titleize}", user.id, { style: member_user_ids.include?(user.id) ? "color: green;" : "color: black;", data: { already_added: member_user_ids.include?(user.id) } }] }),
                class: "form-control form-select-sm bg-secondary-subtle text-dark border-0 shadow-sm flex-grow-1",
                required: true,
                prompt: "-- SELECT --"
              = button_tag "Add", type: "submit", class: "btn btn-sm btn-primary ms-2"

    .row
      .col-md-12
        .form-group
          %label Members:
          .row
            .col-md-3.col-12
              = label_tag :member_role_filter, "Filter by role"
              = select_tag :member_role_filter, options_for_select([["All roles", ""], ["Developer", "developer"], ["Requester", "requester"], ["Viewer", "viewer"], ["Unassigned", "unassigned"]]), class: "form-control form-select-sm"
          %table#concern-members-table.table.table-bordered.mt-2
            %thead
              %tr
                %th.text-center{ style: "width: 1%;" }
                %th.text-center Member Name
                %th.text Roles
                %th.text Status
            %tbody
              - concern_members.sort_by { |ct_user| "#{ct_user.user.last_name.downcase}, #{ct_user.user.first_name.downcase}" }.each do |ct_user|
                %tr{ data: { user_id: ct_user.user_id } }
                  %td.text-center{ style: "background-color: #{ct_user.task == 'unassigned' || ct_user.status == 'inactive' ? 'red' : 'green'};" }
                  %td.text-center= "#{ct_user.user.last_name.titleize}, #{ct_user.user.first_name.titleize}"
                  %td.text-center
                    = select_tag "member_settings[#{ct_user.id}][task]",
                      options_for_select([["Developer", "developer"], ["Requester", "requester"], ["Viewer", "viewer"], ["Unassigned", "unassigned"]], ct_user.task || "unassigned"),
                      class: "form-control form-select-sm",
                      form: "edit-concern-form", data: { id: ct_user.id, field: "roles" }
                  %td.text-center
                    = select_tag "member_settings[#{ct_user.id}][status]",
                      options_for_select([["Active", "active"], ["Inactive", "inactive"]], ct_user.status || "active"),
                      class: "form-control form-select-sm",
                      form: "edit-concern-form", data: { id: ct_user.id, field: "status" }
:javascript
  document.addEventListener("DOMContentLoaded", function () {
    const memberRoleFilter = document.getElementById("member_role_filter");
    const memberRows = document.querySelectorAll("#concern-members-table tbody tr");
    function filterMembers() {
      memberRows.forEach(function (row) {
        const role = row.querySelector('select[data-field="roles"]').value.toLowerCase();
        row.hidden = memberRoleFilter.value !== "" && role !== memberRoleFilter.value;
      });
    }
    memberRoleFilter.addEventListener("change", filterMembers);
    document.querySelectorAll('#concern-members-table select[data-field="roles"]').forEach(function (select) {
      select.addEventListener("change", filterMembers);
    });
    filterMembers();

    const leaderSelect = document.getElementById("concern_leader_id");
    function refreshLeaderOptions() {
      const selectedLeader = leaderSelect.value;
      leaderSelect.replaceChildren();
      memberRows.forEach(function (row) {
        const role = row.querySelector('select[data-field="roles"]').value;
        const status = row.querySelector('select[data-field="status"]').value;
        if (role === "developer" && status === "active") {
          leaderSelect.add(new Option(row.cells[1].textContent.trim(), row.dataset.userId));
        }
      });
      leaderSelect.value = selectedLeader;
      leaderSelect.setCustomValidity(leaderSelect.value ? "" : "Select an active developer as the concern leader before saving.");
    }
    leaderSelect.addEventListener("change", function () { leaderSelect.setCustomValidity(""); });
    leaderSelect.value = #{raw json_escape((params[:concern_leader_id] || @concern_ticket.user_id).to_json)};
    refreshLeaderOptions();

    const memberPicker = document.getElementById("ct_user_id");
    function highlightExistingMember() {
      const selected = memberPicker.selectedOptions[0];
      memberPicker.style.color = selected && selected.dataset.alreadyAdded === "true" ? "green" : "";
    }
    memberPicker.addEventListener("change", highlightExistingMember);
    highlightExistingMember();

    function addToList(name, status, listId, hiddenFieldId) {
      const list = document.getElementById(listId);
      const hiddenField = document.getElementById(hiddenFieldId);

      if (!list || !hiddenField) {
        console.error("Missing elements:", { list, hiddenField });
        return;
      }

      if (name !== "") {
        const li = document.createElement("li");
        li.className = "list-group-item d-flex justify-content-between align-items-center";

        const textSpan = document.createElement("span");
        textSpan.textContent = name;

        const statusBadge = document.createElement("span");
        statusBadge.className = "badge ms-2";
        statusBadge.textContent = status;

        if (status.toLowerCase() === "active") {
          statusBadge.classList.add("bg-success");
        } else if (status.toLowerCase() === "pending") {
        statusBadge.classList.add("bg-secondary");
        } else {
          statusBadge.classList.add("bg-danger");
        }

        const toggleBtn = document.createElement("button");
        toggleBtn.className = `btn btn-sm ms-2 ${status.toLowerCase() === "active" ? "btn-danger" : "btn-success"}`;
        toggleBtn.textContent = status.toLowerCase() === "active" ? "Deactivate" : "Activate";

        toggleBtn.addEventListener("click", function (event) {
          event.preventDefault();

          if (statusBadge.textContent.toLowerCase() === "active") {
            statusBadge.textContent = "inactive";
            statusBadge.classList.remove("bg-success");
            statusBadge.classList.add("bg-danger");
            toggleBtn.textContent = "Activate";
            toggleBtn.classList.remove("btn-danger");
            toggleBtn.classList.add("btn-success");
          } else {
            statusBadge.textContent = "active";
            statusBadge.classList.remove("bg-danger");
            statusBadge.classList.add("bg-success");
            toggleBtn.textContent = "Deactivate";
            toggleBtn.classList.remove("btn-success");
            toggleBtn.classList.add("btn-danger");
          }

          updateHiddenField(hiddenField, list);
        });

        li.appendChild(textSpan);
        li.appendChild(statusBadge);
        li.appendChild(toggleBtn);
        list.appendChild(li);

        updateHiddenField(hiddenField, list);
      } else {
        console.warn("Input field is empty");
      }
    }

    function updateHiddenField(hiddenField, list) {
      const items = [...list.children].map((li) => {
        const name = li.firstChild.textContent.trim();
        const status = li.querySelector(".badge").textContent.trim();
        return `${name}:${status}`;
      });
      hiddenField.value = items.join(",");
    }

    function loadExistingRecords() {
      const concernForList = document.getElementById("concern-records-list");
      const concernTypeList = document.getElementById("concern-type-records-list");
      const concernForHidden = document.getElementById("selected-concern-fors");
      const concernTypeHidden = document.getElementById("selected-concern-types");

      if (!concernForList || !concernTypeList || !concernForHidden || !concernTypeHidden) {
        console.error("Missing elements for loading existing records");
        return;
      }

      const existingConcernFors = #{raw @concern_ticket.concern_fors.map { |cf| { name: cf.name, status: cf.status } }.to_json};
      const existingConcernTypes = #{raw @concern_ticket.concern_types.map { |ct| { name: ct.name, status: ct.status } }.to_json};

      existingConcernFors.forEach((cf) => addToList(cf.name, cf.status, "concern-records-list", "selected-concern-fors"));
      existingConcernTypes.forEach((ct) => addToList(ct.name, ct.status, "concern-type-records-list", "selected-concern-types"));
    }

    document.getElementById("add-concern-for").addEventListener("click", function () {
      const inputField = document.getElementById("concern-for-input");
      addToList(inputField.value.trim(), "active", "concern-records-list", "selected-concern-fors");
      inputField.value = "";
    });

    document.getElementById("add-concern-type").addEventListener("click", function () {
      const inputField = document.getElementById("concern-type-input");
      addToList(inputField.value.trim(), "active", "concern-type-records-list", "selected-concern-types");
      inputField.value = "";
    });
    loadExistingRecords();

    const areaSelects = Array.from(document.querySelectorAll(".developer-areas-select"));
    const areaPickers = new Map();

    function refreshAreaPickers() {
      const assigned = new Set();
      areaSelects.filter((select) => !select.disabled).forEach(function (select) {
        Array.from(select.selectedOptions).forEach((option) => assigned.add(option.value));
      });
      areaSelects.forEach(function (select) {
        const { picker, tags } = areaPickers.get(select);
        picker.disabled = select.disabled;
        picker.replaceChildren(new Option("-- Select an area --", ""));
        Array.from(select.options).forEach(function (option) {
          if (!assigned.has(option.value)) picker.add(new Option(option.textContent, option.value));
        });
        tags.replaceChildren();
        Array.from(select.selectedOptions).forEach(function (option) {
          const tag = document.createElement("span");
          tag.className = "badge bg-primary d-inline-flex align-items-center";
          const name = document.createElement("span");
          name.textContent = option.textContent;
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "btn btn-sm p-0 ms-2 text-white";
          remove.textContent = "×";
          remove.setAttribute("aria-label", "Remove " + option.textContent);
          remove.disabled = select.disabled;
          remove.addEventListener("click", function () {
            option.selected = false;
            refreshAreaPickers();
            picker.focus();
          });
          tag.append(name, remove);
          tags.appendChild(tag);
        });
        if (tags.childElementCount === 0) {
          const placeholder = document.createElement("span");
          placeholder.className = "text-muted";
          placeholder.textContent = "No areas selected";
          tags.appendChild(placeholder);
        }
      });
      document.getElementById("area-assignment-error").hidden = true;
    }

    areaSelects.forEach(function (select) {
      const container = document.createElement("div");
      container.className = "border rounded p-2 bg-white";
      const tags = document.createElement("div");
      tags.className = "d-flex flex-wrap gap-2 mb-2";
      tags.setAttribute("aria-live", "polite");
      const picker = document.createElement("select");
      picker.id = `area_picker_${select.dataset.memberId}`;
      picker.className = "form-control";
      picker.addEventListener("change", function () {
        if (!picker.value) return;
        const option = Array.from(select.options).find((option) => option.value === picker.value);
        if (option) option.selected = true;
        refreshAreaPickers();
      });
      container.append(tags, picker);
      select.after(container);
      select.hidden = true;
      select.style.display = "none";
      areaPickers.set(select, { picker, tags });
    });
    refreshAreaPickers();

    document.querySelectorAll('select[data-field="roles"], select[data-field="status"]').forEach(function (field) {
      field.addEventListener("change", function () {
        const memberId = field.dataset.id;
        const role = document.querySelector(`select[data-id="${memberId}"][data-field="roles"]`);
        const status = document.querySelector(`select[data-id="${memberId}"][data-field="status"]`);
        const select = document.getElementById(`developer_areas_${memberId}`);
        select.disabled = role.value !== "developer" || status.value !== "active";
        select.closest(".developer-areas-row").hidden = select.disabled;
        refreshAreaPickers();
        refreshLeaderOptions();
      });
    });
    document.getElementById("edit-concern-form").addEventListener("submit", function (event) {
      const areas = new Set();
      const duplicates = new Set();
      document.querySelectorAll(".developer-areas-select:not(:disabled)").forEach(function (select) {
        Array.from(select.selectedOptions).forEach(function (option) {
          if (areas.has(option.value)) duplicates.add(option.textContent);
          areas.add(option.value);
        });
      });
      const error = document.getElementById("area-assignment-error");
      error.hidden = duplicates.size === 0;
      if (duplicates.size > 0) {
        event.preventDefault();
        error.textContent = "These areas are selected for multiple developers: " + Array.from(duplicates).join(", ") + ". Remove duplicate selections before saving.";
        error.scrollIntoView({ block: "center", behavior: "smooth" });
      }
    });
  });
